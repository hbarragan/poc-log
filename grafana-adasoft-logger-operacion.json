{
  "uid": "adasoft-logger-operacion",
  "title": "Adasoft Logger - Operacion",
  "tags": ["adasoft", "logs", "loki", "operacion"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Fuentes",
        "type": "query",
        "datasource": { "type": "loki", "uid": "adasoft-loki" },
        "definition": "label_values({job=\"adasoft-logger-api\"}, source_id)",
        "query": { "query": "label_values({job=\"adasoft-logger-api\"}, source_id)", "refId": "LokiVariableQueryEditor-VariableQuery" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "level",
        "label": "Nivel",
        "type": "custom",
        "query": "fatal,error,warn,info,debug",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "search",
        "label": "Busqueda global",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Adasoft Logger",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Operacion de logs**  \nFiltra fuentes, nivel y texto. Los paneles inferiores reproducen una consola por fuente y permiten abrir el detalle nativo de cada linea.  \n[Administrar paths y vistas en POC Log](http://127.0.0.1:2500/?section=admin)"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fuentes con actividad",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "count(sum by (source_id) (count_over_time({job=\"adasoft-logger-api\", source_id=~\"${source:regex}\"}[$__range])))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lineas visibles",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 3 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=~\"${level:regex}\"} |= \"$search\" [$__range]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errores y fatales",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 3 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=~\"error|fatal\"} |= \"$search\" [$__range]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Warnings",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 3 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=\"warn\"} |= \"$search\" [$__range]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Volumen por nivel",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (count_over_time({job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=~\"${level:regex}\"} |= \"$search\" [$__interval]))", "legendFormat": "{{level}}" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errores por fuente",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (source_id) (count_over_time({job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=~\"error|fatal\"} |= \"$search\" [$__interval]))", "legendFormat": "{{source_id}}" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Vista global cruzada",
      "description": "Todas las fuentes seleccionadas, en orden temporal. Abre una linea para ver labels y contexto.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "{job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=~\"${level:regex}\"} |= \"$search\"" }
      ],
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Logs por fuente",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "logs",
      "title": "$source",
      "description": "Detalle de una fuente. Cada entrada permite expandir contexto y labels.",
      "gridPos": { "h": 15, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "adasoft-loki" },
      "targets": [
        { "refId": "A", "expr": "{job=\"adasoft-logger-api\", source_id=~\"${source:regex}\", level=~\"${level:regex}\"} |= \"$search\"" }
      ],
      "repeat": "source",
      "repeatDirection": "h",
      "maxPerRow": 3,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
